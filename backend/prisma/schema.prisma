// Schema Prisma - Modelo System, SystemNote, SystemAttachment & User
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  name         String?
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id        String   @id @default(uuid())
  name      String   // Nombre Comercial (Obligatorio)
  legalName String?  // Nombre Fiscal
  cif       String?  // NIF
  manualId  String?  // ID Manual
  notes     String?  // Notas
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  systems System[]
  devices Device[]
}

model Subsystem {
  id          String   @id @default(uuid())
  name        String   @unique
  color       String   @default("#005596")
  icon        String   @default("shield")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  systems     System[]
  devices     Device[]
  deviceTypes DeviceType[]
}

model DeviceType {
  id          String    @id @default(uuid())
  name        String    // Nombre del tipo de dispositivo (ej: Cámara de vídeo, Grabadora)
  description String?   // Descripción u observaciones
  subsystemId String
  subsystem   Subsystem @relation(fields: [subsystemId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  devices     Device[]

  @@index([subsystemId])
}

model System {
  id          String     @id @default(uuid())
  name        String
  code        String?
  description String?
  notes       String?    // Notas del Sistema
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subsystemId String?
  subsystem   Subsystem? @relation(fields: [subsystemId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  devices     Device[]
  systemNotes SystemNote[]
  attachments SystemAttachment[]

  @@index([clientId])
  @@index([subsystemId])
}

model SystemNote {
  id        String   @id @default(uuid())
  systemId  String
  system    System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  title     String?  // Título o Etiqueta de la Nota
  content   String   // Contenido de la nota (Obligatorio)
  createdBy String?  // Usuario que la registró
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([systemId])
}

model SystemAttachment {
  id          String   @id @default(uuid())
  systemId    String
  system      System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  filename    String   // Nombre de archivo original
  storedName  String   // Nombre almacenado en disco
  filePath    String   // Ruta relativa de almacenamiento
  mimeType    String   // Tipo MIME (application/pdf, image/png, etc)
  fileSize    Int      // Tamaño en bytes
  createdBy   String?  // Usuario que lo subió
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([systemId])
}

model DeviceStatus {
  id          String   @id @default(uuid())
  name        String   @unique // Operativo, Baja, Falta instalación, etc.
  color       String   @default("#10b981")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices     Device[]
}

model Device {
  id                   String        @id @default(uuid())
  systemId             String
  system               System        @relation(fields: [systemId], references: [id], onDelete: Cascade)
  clientId             String
  client               Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subsystemId          String
  subsystem            Subsystem     @relation(fields: [subsystemId], references: [id])
  deviceTypeId         String
  deviceType           DeviceType    @relation(fields: [deviceTypeId], references: [id], onDelete: Restrict)
  statusId             String?
  status               DeviceStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)
  brand                String?       // Opcional
  model                String?       // Opcional
  serialNumber         String?
  assignedName         String        // Obligatorio
  ipAddress            String?
  macAddress           String?
  credentialsEncrypted String?       // Formato JSON cifrado AES-256-GCM
  rackCabinet          String?
  switchName           String?
  switchPort           String?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([systemId])
  @@index([clientId])
  @@index([subsystemId])
  @@index([deviceTypeId])
  @@index([statusId])
  @@index([ipAddress])
  @@index([macAddress])
}

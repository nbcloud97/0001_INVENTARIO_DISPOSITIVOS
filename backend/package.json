{
  "name": "inventario-dispositivos-backend",
  "version": "1.0.0",
  "description": "Backend API REST para inventario de dispositivos por cliente",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
